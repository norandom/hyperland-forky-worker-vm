# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#fff8f0"

# Main text color
theme[main_fg]="#2b4570"

# Title color for boxes
theme[title]="#2b4570"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#4a90d9"

# Background color of selected item in processes box
theme[selected_bg]="#d5dfeb"

# Foreground color of selected item in processes box
theme[selected_fg]="#4a90d9"

# Color of inactive/disabled text
theme[inactive_fg]="#7b96b4"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#2b4570"

# Background color of the percentage meters
theme[meter_bg]="#d5dfeb"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#2b4570"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#7a5aaf"
theme[mem_box]="#5a9e6f"
theme[net_box]="#c0605a"
theme[proc_box]="#4a90d9"

# Box divider line and small boxes line color
theme[div_line]="#7b96b4"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#5a9e6f"
theme[temp_mid]="#8a6a20"
theme[temp_end]="#c0605a"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#5b7fa5"
theme[cpu_mid]="#2b4570"
theme[cpu_end]="#7a5aaf"

# Mem/Disk free meter
theme[free_start]="#7a5aaf"
theme[free_mid]="#2b4570"
theme[free_end]="#5b7fa5"

# Mem/Disk cached meter
theme[cached_start]="#2b4570"
theme[cached_mid]="#5b7fa5"
theme[cached_end]="#7a5aaf"

# Mem/Disk available meter
theme[available_start]="#8a6a20"
theme[available_mid]="#c0605a"
theme[available_end]="#c0605a"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#5a9e6f"
theme[used_mid]="#5b7fa5"
theme[used_end]="#2b4570"

# Download graph colors
theme[download_start]="#8a6a20"
theme[download_mid]="#c0605a"
theme[download_end]="#c0605a"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#5a9e6f"
theme[upload_mid]="#5b7fa5"
theme[upload_end]="#2b4570"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#5b7fa5"
theme[process_mid]="#2b4570"
theme[process_end]="#7a5aaf"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#fff8f0"
theme[gradient_color_1]="#d9d0c0"
theme[gradient_color_2]="#d5dfeb"
theme[gradient_color_3]="#7b96b4"
theme[gradient_color_4]="#8babc7"
theme[gradient_color_5]="#2b4570"
theme[gradient_color_6]="#2b4570"
theme[gradient_color_7]="#1a2a3f"

+/// hypr-rdp-clearcodec: frames in a row without a visible change before
+/// capture requests drop to the idle rate.
+const IDLE_AFTER_UNCHANGED_FRAMES: u32 = 3;
+
+/// hypr-rdp-clearcodec: cheap whole-frame fingerprint (one pass, ~2 ms for
+/// 16 MB) to tell "pointer moved, nothing changed" from real screen updates.
+fn frame_fingerprint(data: &[u8]) -> u64 {
+    let mut h: u64 = 0xcbf2_9ce4_8422_2325;
+    let mut chunks = data.chunks_exact(8);
+    for c in &mut chunks {
+        let v = u64::from_le_bytes([c[0], c[1], c[2], c[3], c[4], c[5], c[6], c[7]]);
+        h = (h ^ v).wrapping_mul(0x0000_0100_0000_01b3).rotate_left(5);
+    }
+    for &b in chunks.remainder() {
+        h = (h ^ u64::from(b)).wrapping_mul(0x0000_0100_0000_01b3);
+    }
+    h
+}

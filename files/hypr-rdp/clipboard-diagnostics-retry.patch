 impl HyprCliprdrBackend {
+    /// Ask once more, shortly after, for a format the client answered with an error or
+    /// nothing (some clients are not ready right after announcing a new selection).
+    fn retry_once(&mut self, format: Option<ClipboardFormatId>) {
+        let (Some(format), false) = (format, self.retried) else {
+            return;
+        };
+        let Some(sender) = self.event_sender.clone() else {
+            return;
+        };
+        self.retried = true;
+        self.last_requested_format = Some(format);
+        self.request_sent_at = Some(Instant::now());
+        let cancel = Arc::new(AtomicBool::new(false));
+        self.retry_cancel = Some(Arc::clone(&cancel));
+        tracing::debug!(
+            ?format,
+            "Clipboard: requesting the client's data again in 300 ms"
+        );
+        thread::spawn(move || {
+            thread::sleep(RETRY_DELAY);
+            if !cancel.load(Ordering::SeqCst) {
+                let _ = sender.send(ServerEvent::Clipboard(ClipboardMessage::SendInitiatePaste(
+                    format,
+                )));
+            }
+        });
+    }
+

+    #[test]
+    fn a_new_copy_replaces_a_planned_retry() {
+        let (mut backend, mut event_rx) = backend_with_events();
+        let text = [ClipboardFormat::new(ClipboardFormatId::CF_UNICODETEXT)];
+        backend.on_remote_copy(&text);
+        let _ = recv_clipboard_event(&mut event_rx);
+        backend.handle_format_data_response(FormatDataResponse::new_error(), MAX_CLIPBOARD_SIZE);
+        // New copy before the retry fires: requested at once, the retry is dropped.
+        backend.on_remote_copy(&text);
+        let ClipboardMessage::SendInitiatePaste(_) = recv_clipboard_event(&mut event_rx) else {
+            panic!("expected an immediate request");
+        };
+        std::thread::sleep(RETRY_DELAY * 3);
+        assert!(event_rx.try_recv().is_err());
+    }
+
+    #[test]
+    fn an_error_answer_is_retried_once() {
+        let (mut backend, mut event_rx) = backend_with_events();
+        backend.on_remote_copy(&[ClipboardFormat::new(ClipboardFormatId::CF_UNICODETEXT)]);
+        let _ = recv_clipboard_event(&mut event_rx);
+        backend.handle_format_data_response(FormatDataResponse::new_error(), MAX_CLIPBOARD_SIZE);
+        std::thread::sleep(RETRY_DELAY * 3);
+        let ClipboardMessage::SendInitiatePaste(format) = recv_clipboard_event(&mut event_rx)
+        else {
+            panic!("expected a retry");
+        };
+        assert_eq!(format, ClipboardFormatId::CF_UNICODETEXT);
+        // A second error is not retried again.
+        backend.handle_format_data_response(FormatDataResponse::new_error(), MAX_CLIPBOARD_SIZE);
+        std::thread::sleep(RETRY_DELAY * 3);
+        assert!(event_rx.try_recv().is_err());
+    }

{
  "name": "debian-hypr Petrol (orange on petrol)",
  "author": "debian-hypr (matches the Terminator profile)",
  "globals": {
    "background": "#002b36",
    "foreground": "#ff911d",
    "caret": "#62a0ea",
    "selection": "#1d4f5c",
    "selection_border": "#1d4f5c",
    "line_highlight": "#073642",
    "gutter": "#002b36",
    "gutter_foreground": "#839496",
    "line_diff_added": "#85c25a",
    "line_diff_modified": "#ffb35c",
    "line_diff_deleted": "#ef2929",
    "find_highlight": "#ffb35c",
    "find_highlight_foreground": "#002b36",
    "invisibles": "#586e75",
    "brackets_foreground": "#ffb35c",
    "bracket_contents_foreground": "#ffb35c",
    "tags_foreground": "#ffb35c",
    "minimap_border": "#073642",
    "active_guide": "#839496",
    "guide": "#073642"
  },
  "rules": [
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "foreground": "#839496",
      "font_style": "italic"
    },
    {
      "name": "String",
      "scope": "string",
      "foreground": "#85c25a"
    },
    {
      "name": "Number, constant",
      "scope": "constant.numeric, constant.language, constant.character",
      "foreground": "#fce94f"
    },
    {
      "name": "Keyword, storage",
      "scope": "keyword, storage.type, storage.modifier",
      "foreground": "#eee8d5"
    },
    {
      "name": "Operator",
      "scope": "keyword.operator",
      "foreground": "#ff911d"
    },
    {
      "name": "Function",
      "scope": "entity.name.function, support.function, variable.function",
      "foreground": "#729fcf"
    },
    {
      "name": "Type, class",
      "scope": "entity.name.type, entity.name.class, support.type, support.class",
      "foreground": "#34e2e2"
    },
    {
      "name": "Tag, heading",
      "scope": "entity.name.tag, markup.heading",
      "foreground": "#eee8d5",
      "font_style": "bold"
    },
    {
      "name": "Attribute",
      "scope": "entity.other.attribute-name",
      "foreground": "#729fcf"
    },
    {
      "name": "Variable",
      "scope": "variable.parameter, variable.other.readwrite",
      "foreground": "#ff911d"
    },
    {
      "name": "Markup link",
      "scope": "markup.underline.link, string.other.link",
      "foreground": "#729fcf"
    },
    {
      "name": "Markup bold/italic",
      "scope": "markup.bold",
      "font_style": "bold"
    },
    {
      "name": "Markup italic",
      "scope": "markup.italic",
      "font_style": "italic"
    },
    {
      "name": "Inserted",
      "scope": "markup.inserted",
      "foreground": "#85c25a"
    },
    {
      "name": "Deleted",
      "scope": "markup.deleted",
      "foreground": "#ef2929"
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "foreground": "#002b36",
      "background": "#ef2929"
    }
  ]
}

{
  "name": "debian-hypr Cobalt (cream-blue)",
  "author": "debian-hypr (matches the Terminator profile)",
  "globals": {
    "background": "#0049b2",
    "foreground": "#fff8f0",
    "caret": "#f1dc9a",
    "selection": "#1453af",
    "selection_border": "#1453af",
    "line_highlight": "#0041a0",
    "gutter": "#0049b2",
    "gutter_foreground": "#8bb4e0",
    "line_diff_added": "#7ac48a",
    "line_diff_modified": "#ffe9a8",
    "line_diff_deleted": "#e87a74",
    "find_highlight": "#ffe9a8",
    "find_highlight_foreground": "#0049b2",
    "invisibles": "#8bb4e0",
    "brackets_foreground": "#ffe9a8",
    "bracket_contents_foreground": "#ffe9a8",
    "tags_foreground": "#ffe9a8",
    "minimap_border": "#0041a0",
    "active_guide": "#8bb4e0",
    "guide": "#0041a0"
  },
  "rules": [
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "foreground": "#b8d3f0",
      "font_style": "italic"
    },
    {
      "name": "String",
      "scope": "string",
      "foreground": "#7ac48a"
    },
    {
      "name": "Number, constant",
      "scope": "constant.numeric, constant.language, constant.character",
      "foreground": "#e8a87c"
    },
    {
      "name": "Keyword, storage",
      "scope": "keyword, storage.type, storage.modifier",
      "foreground": "#f1dc9a"
    },
    {
      "name": "Operator",
      "scope": "keyword.operator",
      "foreground": "#fff8f0"
    },
    {
      "name": "Function",
      "scope": "entity.name.function, support.function, variable.function",
      "foreground": "#8bb4e0"
    },
    {
      "name": "Type, class",
      "scope": "entity.name.type, entity.name.class, support.type, support.class",
      "foreground": "#d29acb"
    },
    {
      "name": "Tag, heading",
      "scope": "entity.name.tag, markup.heading",
      "foreground": "#f1dc9a",
      "font_style": "bold"
    },
    {
      "name": "Attribute",
      "scope": "entity.other.attribute-name",
      "foreground": "#8bb4e0"
    },
    {
      "name": "Variable",
      "scope": "variable.parameter, variable.other.readwrite",
      "foreground": "#fff8f0"
    },
    {
      "name": "Markup link",
      "scope": "markup.underline.link, string.other.link",
      "foreground": "#8bb4e0"
    },
    {
      "name": "Markup bold/italic",
      "scope": "markup.bold",
      "font_style": "bold"
    },
    {
      "name": "Markup italic",
      "scope": "markup.italic",
      "font_style": "italic"
    },
    {
      "name": "Inserted",
      "scope": "markup.inserted",
      "foreground": "#7ac48a"
    },
    {
      "name": "Deleted",
      "scope": "markup.deleted",
      "foreground": "#e87a74"
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "foreground": "#0049b2",
      "background": "#e87a74"
    }
  ]
}

    "terminal.ansiBrightBlack": "#1453af",
    "terminal.ansiRed": "#e87a74",
    "terminal.ansiBrightRed": "#e87a74",
    "terminal.ansiGreen": "#7ac48a",
    "terminal.ansiBrightGreen": "#7ac48a",
    "terminal.ansiYellow": "#f1dc9a",
    "terminal.ansiBrightYellow": "#ffe9a8",
    "terminal.ansiBlue": "#8bb4e0",
    "terminal.ansiBrightBlue": "#8bb4e0",

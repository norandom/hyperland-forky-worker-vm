    "terminal.ansiBrightWhite": "#f5ede0"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5b7fa5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#3a8e4f"
      }
    },
    {
      "name": "Number, constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#a87a2f"
      }
    },
    {
      "name": "Keyword, storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#3a5a8a"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#2b4570"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#7a5aaf"
      }
    },
    {
      "name": "Type, class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#4a90d9"
      }
    },
    {
      "name": "Tag, heading",
      "scope": [
        "entity.name.tag",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#3a5a8a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7a5aaf"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable.parameter",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#2b4570"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#7a5aaf"
      }
    },
    {
      "name": "Markup bold/italic",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#3a8e4f"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#a0403a"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#fff8f0"
      }
    }
  ],
  "semanticHighlighting": false
}

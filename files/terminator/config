[global_config]
  # Slim tmux-style tab bar (styled in ~/.config/gtk-3.0/gtk.css)
  tab_position = bottom
  close_button_on_tab = False
  # Right-click menu "Theme" (plugins/theme_menu.py); cycle with SUPER+Y
  enabled_plugins = ThemeMenu,
  homogeneous_tabbar = False
[keybindings]
[profiles]
  [[default]]
    background_color = "#0049b2"
    font = FiraCode Nerd Font 13
    foreground_color = "#fff8f0"
    show_titlebar = False
    # No blinking: every blink redraws + re-captures the screen (~25% CPU without a GPU)
    cursor_blink = False
    scrollbar_position = hidden
    disable_mousewheel_zoom = True
    palette = "#00347d:#e87a74:#7ac48a:#f1dc9a:#8bb4e0:#b89cd9:#6f88a7:#e8dfc9:#1453af:#e87a74:#7ac48a:#ffe9a8:#8bb4e0:#d29acb:#8bb4e0:#fff8f0"
    use_system_font = False
    copy_on_selection = True
  [[navy]]
    background_color = "#1a2a3f"
    font = FiraCode Nerd Font 11
    foreground_color = "#fff8f0"
    show_titlebar = False
    # No blinking: every blink redraws + re-captures the screen (~25% CPU without a GPU)
    cursor_blink = False
    scrollbar_position = hidden
    palette = "#243b55:#c0605a:#5a9e6f:#c4933f:#4a90d9:#c4a0e0:#5b7fa5:#7b96b4:#3a5a7a:#e87a74:#70b880:#c4933f:#6aabe8:#c4a0e0:#8babc7:#fff8f0"
    use_system_font = False
  [[fixedsys]]
    # Amber on dark navy (as on the Mint desktop). Berkeley Mono is a private font
    # (private data); without it fontconfig falls back to the default monospace.
    background_color = "#1f233c"
    font = Berkeley Mono 12
    foreground_color = "#ffa348"
    scrollback_infinite = True
    palette = "#2e3436:#cc0000:#4e9a06:#c4a000:#3584e4:#75507b:#06989a:#d3d7cf:#555753:#ef2929:#8ae234:#fce94f:#729fcf:#ad7fa8:#34e2e2:#eeeeec"
    use_system_font = False
    bold_is_bright = True
    copy_on_selection = True
    show_titlebar = False
    # No blinking: every blink redraws + re-captures the screen (~25% CPU without a GPU)
    cursor_blink = False
    scrollbar_position = hidden
  [[cream]]
    # Light: navy on cream (norandom/opencode-cream-blue, cream-blue-light)
    background_color = "#fff8f0"
    font = FiraCode Nerd Font 13
    foreground_color = "#2b4570"
    cursor_color = "#2b4570"
    show_titlebar = False
    # No blinking: every blink redraws + re-captures the screen (~25% CPU without a GPU)
    cursor_blink = False
    scrollbar_position = hidden
    disable_mousewheel_zoom = True
    palette = "#2b4570:#a0403a:#3a8e4f:#8a6a20:#3a5a8a:#7a5aaf:#5b7fa5:#ebe3d6:#5b7fa5:#c0605a:#5a9e6f:#a87a2f:#4a90d9:#7a5aaf:#3a5a8a:#f5ede0"
    use_system_font = False
    copy_on_selection = True
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
[plugins]

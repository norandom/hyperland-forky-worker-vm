#!/bin/bash
# XFCE-style application menu with fuzzel (no extra toolkit):
#   hypr-appmenu              categories -> applications, or type an app name (top-left)
#   hypr-appmenu --at X Y     same, opened at X/Y (desktop right-click)
#   hypr-appmenu power        log out / reboot / shut down
# Top: the last HYPR_APPMENU_RECENT (3) applications started from here, then every
# category with its applications under it ("Other" last).
set -u
nrecent=${HYPR_APPMENU_RECENT:-3}
recent=${XDG_STATE_HOME:-$HOME/.local/state}/hypr-appmenu/recent
pos=()
if [ "${1:-}" = --at ]; then
  pos=(--x-margin "$2" --y-margin "$3"); shift 3
fi
menu() { fuzzel --dmenu --anchor top-left --width 32 "${pos[@]}" "$@"; }

if [ "${1:-}" = power ]; then
  choice=$(printf 'Log out\nReboot\nShut down\n' | menu --prompt 'Power > ' --lines 3) || exit 0
  case "$choice" in
    "Log out")   uwsm stop ;;
    "Reboot")    systemctl reboot ;;
    "Shut down") systemctl poweroff ;;
  esac
  exit 0
fi

# "Category<TAB>Name<TAB>desktop-id" for every visible application;
# ~/.local/share/applications overrides /usr/share/applications.
entries() {
  local seen=" " d f id
  for d in "$HOME/.local/share/applications" /usr/local/share/applications /usr/share/applications; do
    for f in "$d"/*.desktop; do
      [ -f "$f" ] || continue
      id=${f##*/}
      case "$seen" in *" $id "*) continue ;; esac
      seen="$seen$id "
      awk -v id="$id" '
        BEGIN {
          m["AudioVideo"]="Multimedia"; m["Audio"]="Multimedia"; m["Video"]="Multimedia"
          m["Development"]="Development"; m["Education"]="Education"; m["Game"]="Games"
          m["Graphics"]="Graphics"; m["Network"]="Internet"; m["Office"]="Office"
          m["Science"]="Science"; m["Settings"]="Settings"; m["System"]="System"
          m["Utility"]="Accessories"
        }
        /^\[/ { sec = $0; next }
        sec != "[Desktop Entry]" { next }
        /^Name=/ && name == "" { name = substr($0, 6) }
        /^Categories=/ { cats = substr($0, 12) }
        /^Type=/ { type = substr($0, 6) }
        /^(NoDisplay|Hidden)=true/ { hidden = 1 }
        END {
          if (hidden || name == "" || (type != "" && type != "Application")) exit
          cat = "Other"; n = split(cats, a, ";")
          for (i = 1; i <= n; i++) if (a[i] in m) { cat = m[a[i]]; break }
          # all text editors together, whatever else they are tagged with
          for (i = 1; i <= n; i++) if (a[i] == "TextEditor") cat = "Editors"
          if (id == "typora.desktop") cat = "Editors"   # Markdown editor, tagged WordProcessor
          printf "%s\t%s\t%s\n", cat, name, id
        }' "$f"
    done
  done
}

# Remember the application (most recent first, no repeats), then start it.
launch() {
  mkdir -p "${recent%/*}"
  { echo "$1"; grep -vxF "$1" "$recent" 2>/dev/null; } | head -n "$nrecent" > "$recent.tmp" &&
    mv "$recent.tmp" "$recent"
  exec uwsm app -- "$1"
}

list=$(entries)
# Top level: recent applications, then each category ("▸ Category", opens it) followed
# by its applications, so typing an app name finds it right away.
# Output: "cat <Category>" or "app <id>".
pick=$( { if [ "$nrecent" -gt 0 ] && [ -f "$recent" ]; then
            head -n "$nrecent" "$recent" | while IFS= read -r id; do
              awk -F'\t' -v id="$id" '$3 == id { printf "↺ %s\tapp %s\n", $2, $3; exit }' <<<"$list"
            done
          fi
          awk -F'\t' -v OFS='\t' '{ print ($1 == "Other" ? "~" : "") $1, $0 }' <<<"$list" |
            sort -t$'\t' -k1,1 -k3,3f | cut -f2- |
            awk -F'\t' '$1 != c { c = $1; printf "▸ %s\tcat %s\n", c, c }
                        { printf "      %s\tapp %s\n", $2, $3 }'; } |
        menu --prompt 'Apps > ' --lines 20 --with-nth=1 --accept-nth=2) || exit 0
case "$pick" in
  app\ *) launch "${pick#app }" ;;
  cat\ *) cat=${pick#cat } ;;
  *) exit 0 ;;
esac

id=$(awk -F'\t' -v c="$cat" '$1 == c { print $2 "\t" $3 }' <<<"$list" | sort -f |
     menu --prompt "$cat > " --with-nth=1 --accept-nth=2) || exit 0
[ -n "$id" ] && launch "$id"

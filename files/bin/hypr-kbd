#!/bin/sh
# Switch the keyboard layout: hypr-kbd de|us|toggle [--quiet]
# Both layouts are loaded in one keymap (input.lua: kb_layout "de,us",
# German = Apple Mac layout without dead keys); this only changes the active one, and hypr-rdp
# follows it (no reconnect). The choice is kept in ~/.local/state/hypr-kbd.
# setxkbmap only reaches X11 apps on Wayland, so this goes through Hyprland.
state="$HOME/.local/state/hypr-kbd"
cur=$(cat "$state" 2>/dev/null || echo de)
case "$1" in
  de|us) new=$1 ;;
  toggle|"") [ "$cur" = us ] && new=de || new=us ;;
  *) echo "usage: hypr-kbd de|us|toggle   (de = German Mac layout, no dead keys)" >&2; exit 2 ;;
esac
[ "$new" = us ] && group=1 || group=0
mkdir -p "${state%/*}" && echo "$new" > "$state"
hyprctl switchxkblayout all "$group" >/dev/null
pkill -RTMIN+9 -x waybar 2>/dev/null
[ "$2" = --quiet ] || echo "keyboard: $new"

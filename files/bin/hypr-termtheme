#!/bin/sh
# Switch all Terminator windows to a profile: hypr-termtheme <profile>|next|prev
# (SUPER+Y or the ● bar button cycle; right-click menu "Theme" in Terminator). New windows opened
# with SUPER+Return use the last choice (~/.local/state/terminator-profile).
state="$HOME/.local/state/terminator-profile"
profiles=$(sed -n '/^\[profiles\]/,/^\[[a-z]/s/^  \[\[\(.*\)\]\]$/\1/p' "$HOME/.config/terminator/config")
cur=$(cat "$state" 2>/dev/null || echo default)
case "$1" in
  prev) new=$(printf '%s\n' $profiles | awk -v c="$cur" '{a[NR]=$0; if ($0==c) i=NR} END{print (i>1) ? a[i-1] : a[NR]}') ;;
  ""|next) new=$(printf '%s\n' $profiles | awk -v c="$cur" 'NR==1{f=$0} p{print; d=1; exit} $0==c{p=1} END{if(!d)print f}' | head -1) ;;
  *) printf '%s\n' $profiles | grep -qx "$1" || { echo "profiles: $profiles" >&2; exit 2; }; new=$1 ;;
esac
[ -n "$new" ] || new=default
mkdir -p "${state%/*}" && echo "$new" > "$state"
remotinator switch_profile_all -p "$new" >/dev/null 2>&1
pkill -RTMIN+10 -x waybar 2>/dev/null
hyprctl notify -1 1500 "rgb(8bb4e0)" "Terminal theme: $new" >/dev/null 2>&1

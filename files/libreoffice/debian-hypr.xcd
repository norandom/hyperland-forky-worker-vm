<?xml version="1.0" encoding="UTF-8"?>
<!-- Managed by debian-hypr (tasks/apps.py): Writer and Calc start with the Tabbed UI (ribbon
     like MS Office). "Active" takes the mode's CommandArg (notebookbar.ui), not its name.
     A choice in View > User Interface still wins per user. -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>
  <oor:component-data oor:package="org.openoffice.Office.UI" oor:name="ToolbarMode">
    <node oor:name="Applications">
      <node oor:name="Writer" oor:op="fuse">
        <prop oor:name="Active"><value>notebookbar.ui</value></prop>
      </node>
      <node oor:name="Calc" oor:op="fuse">
        <prop oor:name="Active"><value>notebookbar.ui</value></prop>
      </node>
    </node>
  </oor:component-data>
</oor:data>

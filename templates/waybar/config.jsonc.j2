// Managed by debian-hypr (template: bar_graphs = {{ host.data.bar_graphs }}). Minimal bar: clock + CPU/MEM/net, like the Omarchy setup.
{
  "layer": "top",
  "position": "top",
  "height": 26,
  "spacing": 14,
  "modules-left": ["custom/menu", "custom/files", "custom/term", "custom/web", "custom/layout", "wlr/taskbar"],
  "modules-center": ["clock"],
  "modules-right": ["custom/quota", {% if host.data.bar_graphs %}"custom/cpu", "custom/mem", "custom/net"{% else %}"cpu", "memory", "network"{% endif %}, "group/audio", "tray", "hyprland/submap", "custom/nightmode", "custom/termtheme", "custom/kbd", "custom/power"],
  "custom/menu": {
    "format": "☰ Apps",
    "tooltip-format": "Applications (right-click: search)",
    "on-click": "$HOME/.local/bin/hypr-launch $HOME/.local/bin/hypr-appmenu",
    "on-click-right": "$HOME/.local/bin/hypr-launch uwsm app -- fuzzel"
  },
  // Quick launchers: the apps' own icons are the CSS background (see style.css).
  // Apps start through hypr-launch (Hyprland), never as waybar's children:
  // waybar kills the processes it started whenever it reloads.
  "custom/files": { "format": " ", "tooltip-format": "File manager (Xfe)", "on-click": "$HOME/.local/bin/hypr-launch uwsm app -- xfe" },
  "custom/term": { "format": " ", "tooltip-format": "Terminator", "on-click": "$HOME/.local/bin/hypr-launch uwsm app -- hypr-term" },
  "custom/web": { "format": " ", "tooltip-format": "Vivaldi", "on-click": "$HOME/.local/bin/hypr-launch uwsm app -- vivaldi-stable" },
  // Red square with the Debian swirl: the PNG is the CSS background (see style.css).
  // (waybar 0.15's "image" module hangs the bar at startup.)
  "custom/power": {
    "format": " ",
    "tooltip-format": "Log out / reboot / shut down",
    "on-click": "$HOME/.local/bin/hypr-launch $HOME/.local/bin/hypr-appmenu power"
  },
  // Night filter: rabbit black = off, green = mint night filter, white = dark (click: next)
  "custom/nightmode": {
    "exec": "$HOME/.local/bin/hypr-nightmode status",
    "return-type": "json",
    "interval": "once",
    "signal": 12,
    "on-click": "$HOME/.local/bin/hypr-nightmode next",
    "on-click-right": "$HOME/.local/bin/hypr-nightmode off"
  },
  "custom/termtheme": {
    "exec": "t=$(cat $HOME/.local/state/terminator-profile 2>/dev/null || echo default); printf '{\"text\":\"●\",\"class\":\"%s\",\"tooltip\":\"Terminal theme: %s (click: next, right-click: previous)\"}\\n' \"$t\" \"$t\"",
    "return-type": "json",
    "interval": "once",
    "signal": 10,
    "on-click": "$HOME/.local/bin/hypr-termtheme next",
    "on-click-right": "$HOME/.local/bin/hypr-termtheme prev"
  },
  // SUPER badge while one-shot Super (SHIFT + Print) is armed
  "hyprland/submap": { "format": "SUPER", "tooltip": false },
  "custom/kbd": {
    "exec": "printf '⌨ %s\\n' $( (cat $HOME/.local/state/hypr-kbd 2>/dev/null || echo de) | tr a-z A-Z)",
    "interval": "once",
    "signal": 9,
    "tooltip-format": "Keyboard layout (click: switch US / DE)",
    "on-click": "$HOME/.local/bin/hypr-kbd toggle"
  },
  "custom/layout": {
    "exec": "cat $HOME/.config/hypr/layout-mode 2>/dev/null || echo dynamic",
    "interval": "once",
    "signal": 8,
    "format": "▦ {}",
    "tooltip-format": "Layout mode (click or SUPER+L: next)",
    "on-click": "$HOME/.local/bin/hypr-layout next"
  },
  // Window list: click = bring to front (also un-minimizes), middle-click = close.
  "wlr/taskbar": {
    "format": "{icon} {title:.22}",
    "icon-size": 16,
    "icon-theme": "Adwaita",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": ["fuzzel"]
  },
  "clock": { "format": "{:%A %H:%M}", "format-alt": "{:%d %B %Y  W%V}", "tooltip": false },
{% if host.data.bar_graphs %}
  // CPU / memory / network with a sparkline of the last 50 s (hypr-sparkline, every 5 s)
  "custom/cpu": { "exec": "$HOME/.local/bin/hypr-sparkline cpu", "return-type": "json",
                  "on-click": "$HOME/.local/bin/hypr-launch uwsm app -- terminator -x btop" },
  "custom/mem": { "exec": "$HOME/.local/bin/hypr-sparkline mem", "return-type": "json" },
  "custom/net": { "exec": "$HOME/.local/bin/hypr-sparkline net", "return-type": "json" },
{% else %}
  // CPU / memory / network as numbers (bar_graphs = False)
  "cpu": { "interval": 5, "format": "CPU {usage}%", "on-click": "$HOME/.local/bin/hypr-launch uwsm app -- terminator -x btop" },
  "memory": { "interval": 5, "format": "MEM {percentage}%", "tooltip-format": "{used:0.1f} / {total:0.1f} GiB used" },
  "network": {
    "interval": 5,
    "format": "↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
    "format-disconnected": "offline",
    "tooltip-format": "{ifname} {ipaddr}"
  },
{% endif %}
  // AI agents: weekly quota left (Claude, Codex), every 5 min; click = refresh
  "custom/quota": {
    "exec": "$HOME/.local/bin/hypr-agent-quota",
    "return-type": "json",
    "interval": 300,
    "signal": 11,
    "on-click": "pkill -RTMIN+11 -x waybar"
  },
  // Speaker icon; hover reveals the volume slider. Click = mute, scroll = ±5%.
  "group/audio": {
    "orientation": "horizontal",
    "drawer": { "transition-duration": 250, "transition-left-to-right": false },
    "modules": ["pulseaudio", "pulseaudio/slider"]
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "tooltip-format": "Volume {volume}% (click: mute, scroll: adjust, hover: slider)",
    "scroll-step": 5,
    "max-volume": 100,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "pulseaudio/slider": { "min": 0, "max": 100, "orientation": "horizontal" },
  "tray": { "spacing": 8 }
}

-- Managed by debian-hypr.
-- Apple German keyboard via RoyalTS/RDP, Mac layout (de mac_nodeadkeys): Left Option
-- (and Right Cmd) is the Option key (@ = Option+L, EUR = Option+E, | = Option+7);
-- Right Option acts as Super. Alt+Tab is SUPER+Tab (there is no Alt key).
-- Both layouts live in one keymap ({{ host.data.keyboard_layout }}); hypr-kbd switches
-- the active one. The choice (~/.local/state/hypr-kbd) is re-applied after
-- every config load.
hl.config({
  input = {
    kb_layout = "{{ host.data.keyboard_layout }}",
    kb_variant = "{{ host.data.keyboard_variant }}",
    kb_options = "{{ host.data.keyboard_options }}",
    follow_mouse = 1,
    sensitivity = 0,
    repeat_rate = 40,
    repeat_delay = 250,
    numlock_by_default = true,
  },
})

hl.timer(function()
  local f = io.open(os.getenv("HOME") .. "/.local/state/hypr-kbd", "r")
  if not f then return end
  local k = (f:read("l") or ""):match("%a+"); f:close()
  if k then hl.exec_cmd("$HOME/.local/bin/hypr-kbd " .. k .. " --quiet") end
end, { timeout = 300, type = "oneshot" })
